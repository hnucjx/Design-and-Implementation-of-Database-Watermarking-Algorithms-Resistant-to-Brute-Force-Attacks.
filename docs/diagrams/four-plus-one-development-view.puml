@startuml
title 4+1 Development View
skinparam componentStyle rectangle
skinparam shadowing false

package "frontend/src" {
  [App.tsx] as App
  [components/JobQueue.tsx] as JobQueue
  [components/ProxySection.tsx] as ProxySection
  [components/CookieSection.tsx] as CookieSection
  [components/HelpPopover.tsx] as HelpPopover
  [api.ts] as ApiClient
  [types.ts] as FrontendTypes
  [quality.ts] as Quality
  [formatting.ts] as Formatting
}

package "backend/app" {
  [main.py] as Main
  [config.py] as Config
  [schemas.py] as Schemas
  [models.py] as Models
  [db.py] as DB
  [job_manager.py] as Manager
  [job_read_model.py] as ReadModel
  [events.py] as Broker
  [ytdlp_service.py] as Service
  [ytdlp_formats.py] as FormatHelpers
  [stall_guard.py] as StallGuard
  [fallback_policy.py] as Fallback
  [download_progress.py] as Progress
  [progress_persist.py] as PersistGate
  [transfer_stats.py] as TransferStats
  [browser_cookies.py] as BrowserCookies
  [cookie_health.py] as CookieHealth
  [proxy.py] as ProxyResolver
  [connectivity.py] as Connectivity
  [error_advice.py] as ErrorAdvice
  [runtime_env.py] as RuntimeEnv
  [logging_setup.py] as LoggingSetup
  [dev_server.py] as DevServer
  [__main__.py] as CliEntry
  [output_paths.py] as OutputPaths
  [paths.py] as Paths
  [log_safety.py] as LogSafety
  [system_open.py] as SystemOpen
}

package "tests" {
  [backend/tests] as BackendTests
  [frontend/src/App.test.tsx] as FrontendTests
}

package "scripts" {
  [docs.py] as DocsScript
  [check_doc_anchors.py] as AnchorScript
  [acceptance_network.py] as AcceptanceNetwork
  [bench_concurrency.py] as BenchConcurrency
  [bench_throttle_guard.py] as BenchThrottle
  [export_cookies_via_cdp.py] as CookieExport
  [acceptance_real.py] as AcceptanceReal
}

App --> JobQueue
App --> ProxySection
App --> CookieSection
App --> ApiClient
App --> Quality
App --> Formatting
ApiClient --> FrontendTypes
JobQueue --> FrontendTypes
ProxySection --> ApiClient
CookieSection --> ApiClient
ProxySection --> HelpPopover
CookieSection --> HelpPopover

CliEntry --> Main
CliEntry --> DevServer
Main --> Config
Main --> Schemas
Main --> Manager
Main --> ReadModel
Main --> Service
Main --> DB
Main --> CookieHealth
Main --> Connectivity
Main --> RuntimeEnv
Main --> LoggingSetup
Manager --> Models
Manager --> Service
Manager --> Broker
Manager --> Fallback
Manager --> Progress
Manager --> PersistGate
Manager --> TransferStats
Manager --> OutputPaths
Manager --> Paths
Manager --> LogSafety
Manager --> SystemOpen
Manager --> ErrorAdvice
ReadModel --> Models
ReadModel --> Fallback
ReadModel --> OutputPaths
Service --> FormatHelpers
Service --> BrowserCookies
Service --> ProxyResolver
Service --> ErrorAdvice
Service --> StallGuard
Service --> SystemOpen
CookieHealth --> Connectivity
CookieHealth --> ProxyResolver
Connectivity --> ProxyResolver
ErrorAdvice --> LogSafety
DB --> Models

BackendTests ..> Main
BackendTests ..> Manager
BackendTests ..> Service
BackendTests ..> CookieHealth
BackendTests ..> ErrorAdvice
FrontendTests ..> App
AcceptanceNetwork ..> Service
AcceptanceNetwork ..> Connectivity
AcceptanceNetwork ..> CookieHealth
BenchConcurrency ..> Manager
BenchThrottle ..> Service
DocsScript ..> Main : doc checks only
AnchorScript ..> Main : doc anchor checks only
@enduml
