@startuml
title Component Overview
skinparam componentStyle rectangle
skinparam shadowing false

package "Frontend" {
  [App.tsx\nstate + SSE + panels] as App
  [JobQueue.tsx\ntask center] as Queue
  [api.ts\nHTTP boundary] as ApiClient
  [types.ts] as Types
  [quality.ts] as Quality
  [formatting.ts] as Formatting
}

package "Backend / entry" {
  [main.py\nFastAPI routes + lifespan] as Main
  [schemas.py\nrequest/response models] as Schemas
  [config.py\nAppSettings] as Config
}

package "Backend / orchestration" {
  [job_manager.py\nqueue + workers] as Manager
  [job_read_model.py\nAPI projection] as ReadModel
  [events.py\nEventBroker (SSE)] as Broker
}

package "Backend / download" {
  [ytdlp_service.py\nyt-dlp boundary] as Service
  [ytdlp_formats.py\nselectors] as Formats
  [stall_guard.py\nstall watchdog] as StallGuard
  [browser_cookies.py\ncookie import] as Cookies
  [system_open.py\nplayer / folder opener] as SystemOpen
  [output_paths.py\noutput discovery] as OutputPaths
}

package "Backend / progress" {
  [download_progress.py\nstream aggregation] as Progress
  [progress_persist.py\npersist gate] as PersistGate
  [transfer_stats.py\naverage speed] as Stats
}

package "Backend / support" {
  [models.py\nSQLModel tables] as Models
  [db.py\nengine + pragmas] as DB
  [fallback_policy.py\ndowngrade messages] as Fallback
  [paths.py\nsafe names] as Paths
  [log_safety.py\nlog scrubbing] as LogSafety
}

App --> Queue
App --> ApiClient
App --> Quality
App --> Formatting
Queue --> Formatting
ApiClient --> Types
ApiClient --> Main : HTTP + SSE
Main --> Config
Main --> Schemas
Main --> Manager
Main --> ReadModel
Main --> Service
Main --> DB
Main --> SystemOpen
Manager --> Service
Manager --> Progress
Manager --> PersistGate
Manager --> Stats
Manager --> Fallback
Manager --> OutputPaths
Manager --> Paths
Manager --> LogSafety
Manager --> Broker
Manager --> Models
ReadModel --> Fallback
ReadModel --> OutputPaths
ReadModel --> Models
Service --> Formats
Service --> Cookies
Service --> StallGuard
DB --> Models
Broker --> Main : event stream
@enduml
