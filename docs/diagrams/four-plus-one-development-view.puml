@startuml
title 4+1 Development View
skinparam componentStyle rectangle
skinparam shadowing false

package "frontend/src" {
  [App.tsx] as App
  [components/UrlAnalyzer.tsx] as UrlAnalyzer
  [components/AnalysisPanel.tsx] as AnalysisPanel
  [components/DownloadOptionsPanel.tsx] as OptionsPanel
  [components/SettingsPanel.tsx] as SettingsPanel
  [components/SearchableLanguageSelect.tsx] as LanguageSelect
  [components/Toggle.tsx] as Toggle
  [components/StatusPill.tsx] as StatusPill
  [components/JobQueue.tsx] as JobQueue
  [components/ProxySection.tsx] as ProxySection
  [components/CookieSection.tsx] as CookieSection
  [components/HelpPopover.tsx] as HelpPopover
  [api.ts] as ApiClient
  [types.ts] as FrontendTypes
  [quality.ts] as Quality
  [formatting.ts] as Formatting
  [subtitles.ts] as Subtitles
  [cookieLock.ts] as CookieLock
}

package "backend/app" {
  [main.py] as Main
  [routers/diagnostics.py] as RtDiagnostics
  [routers/cookies.py] as RtCookies
  [routers/analyze.py] as RtAnalyze
  [routers/jobs.py] as RtJobs
  [routers/job_files.py] as RtJobFiles
  [routers/settings.py] as RtSettings
  [routers/events.py] as RtEvents
  [api_context.py] as ApiContext
  [api_support.py] as ApiSupport
  [job_artifacts.py] as JobArtifacts
  [config.py] as Config
  [schemas.py] as Schemas
  [models.py] as Models
  [db.py] as DB
  [job_manager.py] as Manager
  [job_read_model.py] as ReadModel
  [events.py] as Broker
  [ytdlp_service.py] as Service
  [ytdlp_formats.py] as FormatHelpers
  [stall_guard.py] as StallGuard
  [fallback_policy.py] as Fallback
  [download_progress.py] as Progress
  [progress_persist.py] as PersistGate
  [transfer_stats.py] as TransferStats
  [browser_cookies.py] as BrowserCookies
  [cookie_health.py] as CookieHealth
  [proxy.py] as ProxyResolver
  [connectivity.py] as Connectivity
  [error_advice.py] as ErrorAdvice
  [runtime_env.py] as RuntimeEnv
  [logging_setup.py] as LoggingSetup
  [dev_server.py] as DevServer
  [__main__.py] as CliEntry
  [output_paths.py] as OutputPaths
  [paths.py] as Paths
  [log_safety.py] as LogSafety
  [system_open.py] as SystemOpen
}

package "tests" {
  [backend/tests] as BackendTests
  [frontend/src/App.test.tsx] as FrontendTests
}

package "scripts" {
  [docs.py] as DocsScript
  [check_doc_anchors.py] as AnchorScript
  [acceptance_network.py] as AcceptanceNetwork
  [bench_concurrency.py] as BenchConcurrency
  [bench_throttle_guard.py] as BenchThrottle
  [export_cookies_via_cdp.py] as CookieExport
  [acceptance_real.py] as AcceptanceReal
}

