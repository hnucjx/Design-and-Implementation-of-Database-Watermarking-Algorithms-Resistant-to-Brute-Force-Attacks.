@startuml
title Backend Module Dependencies
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "L0 entry" {
  [main.py\ncomposition root] as Main
  [routers/*\nHTTP endpoints] as Routers
  [api_context.py\nrequest dependencies] as ApiCtx
  [api_support.py\nendpoint helpers] as ApiSupport
  [job_artifacts.py\nartifact location] as Artifacts
}

package "L1 contracts" {
  [config.py\nAppSettings] as Config
  [schemas.py\nwire models] as Schemas
  [models.py\nSQLModel tables] as Models
}

package "L2 orchestration" {
  [job_manager.py\nqueue, workers, state machine] as Manager
  [job_read_model.py\nAPI projection] as ReadModel
  [events.py\nEventBroker] as Broker
}

package "L3 domain and policy" {
  [ytdlp_service.py\nyt-dlp boundary] as Service
  [ytdlp_formats.py\nselectors, fallback math] as Formats
  [stall_guard.py\nstall watchdog] as Stall
  [fallback_policy.py\nreason and message] as Fallback
  [resolution_decisions.py\ndowngrade decisions] as Decisions
  [browser_cookies.py\ncookie import] as Cookies
  [cookie_health.py\ncookie verification] as CookieHealth
  [proxy.py\nproxy resolution] as Proxy
  [connectivity.py\nproxy probe] as Connectivity
  [error_advice.py\nexception to advice] as Advice
  [download_progress.py\nsubstream aggregation] as Progress
  [progress_persist.py\npersist gate] as Gate
  [transfer_stats.py\naverage speed] as Stats
  [output_paths.py\npath discovery] as Outputs
  [system_open.py\nplayer and folder] as Opener
}

package "L4 infrastructure" {
  [db.py\nengine, pragmas, migrations] as DB
  [logging_setup.py\nroot logger, rotating file] as Logging
}

package "L5 pure helpers" {
  [paths.py\nsafe path names] as Paths
  [log_safety.py\nlog scrubbing] as LogSafe
  [runtime_env.py\nhostile env scrubbing] as RuntimeEnv
}

Main --> Routers
Main --> ApiCtx
Main --> ApiSupport
Main --> Config
Main --> Schemas
Main --> Manager
Main --> ReadModel
Main --> Service
Main --> DB
Main --> CookieHealth
Main --> Connectivity
Main --> Logging
Main --> RuntimeEnv
Routers --> ApiCtx
Routers --> ApiSupport
Routers --> Artifacts
Routers --> Schemas
Routers --> Manager
Routers --> Service
Routers --> CookieHealth
Routers --> Connectivity
Routers --> RuntimeEnv
Routers --> Proxy
Routers --> Broker
ApiCtx --> Manager
ApiCtx --> Service
ApiCtx --> DB
ApiCtx --> Config
ApiSupport --> ReadModel
ApiSupport --> Models
ApiSupport --> Schemas
ApiSupport --> Service
ApiSupport --> Proxy
ApiSupport --> Paths
Artifacts --> Models
Artifacts --> Outputs
Artifacts --> Opener
Manager --> Models
Manager --> Service
Manager --> Advice
Manager --> Progress
Manager --> Gate
Manager --> Stats
Manager --> Stall
Manager --> Fallback
Manager --> Decisions
Manager --> Outputs
Manager --> Broker
Manager --> Paths
Manager --> LogSafe
ReadModel --> Models
ReadModel --> Fallback
ReadModel --> Outputs
Service --> Formats
Service --> Cookies
Service --> Proxy
Service --> Advice
Service --> Stall
